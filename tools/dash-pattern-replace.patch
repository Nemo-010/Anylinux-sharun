 /*
+ * Append n bytes of the string on the stack, starting at offset from, to the
+ * string on the stack. The stack may move when it grows, so no pointer into
+ * it is kept across this.
+ */
+static void replcopy(int from, int n)
+{
+	char *q;
+
+	if (n <= 0)
+		return;
+	q = makestrspace(n, expdest);
+	memmove(q, (char *)stackblock() + from, n);
+	expdest = q + n;
+}
+
+/*
+ * ${var/pat/str}, ${var//pat/str}, ${var/#pat/str} and ${var/%pat/str}.
+ *
+ * The value of var is on the stack from startloc, followed by a NUL, and
+ * the pattern comes right after it at patloc. The pattern is expanded like
+ * the one of ${var#pat}, str is expanded to plain text and put after the
+ * pattern. The result is built after that and moved over the value.
+ * The longest match is replaced, as bash does.
+ */
+static char *subevalrepl(char *start, int patloc, int startloc,
+			 int varflags, int flag)
+{
+	int subtype = varflags & VSTYPE;
+	int anchored = subtype == VSREPLACEBEG || subtype == VSREPLACEEND;
+	int literal;
+	int hasrepl;
+	int prefilter;
+	int strloc;
+	int repoff;
+	int resoff;
+	int endoff;
+	int cursor;
+	int off;
+	size_t replen;
+	char *repl;
+	char *loc;
+	char *str;
+	char *p;
+	int c0;
+
+	p = argstr(start, (flag & EXP_DISCARD) | EXP_TILDE | EXP_CASE |
+			  EXP_STOPSLASH);
+	hasrepl = p[-1] == '/';
+	if (flag & EXP_DISCARD) {
+		if (hasrepl)
+			p = argstr(p, EXP_DISCARD);
+		return p;
+	}
+
+	if (hasrepl && subtype == VSREPLACEALL && p == start + 1) {
+		/* bash: in ${var///str} the first / is part of the pattern */
+		expdest--;
+		STPUTC('/', expdest);
+		p = argstr(p, EXP_TILDE | EXP_CASE | EXP_STOPSLASH);
+		hasrepl = p[-1] == '/';
+	}
+
+	if (FNMATCH_IS_ENABLED)
+		sh_error("pattern substitution needs a build without "
+			 "--enable-fnmatch");
+
+	/* the pattern is converted in place, it stays at patloc */
+	str = preglob((char *)stackblock() + patloc, 0);
+	strloc = str - (char *)stackblock();
+
+	repoff = expdest - (char *)stackblock();
+	if (hasrepl)
+		p = argstr(p, 0);
+	replen = expdest - (char *)stackblock() - repoff;
+	if (hasrepl && replen)
+		replen--;	/* the NUL that ends it */
+	else
+		replen = 0;
+
+	INTOFF;
+	repl = ckmalloc(replen + 1);
+	INTON;
+	memcpy(repl, (char *)stackblock() + repoff, replen);
+	repl[replen] = '\0';
+
+	/* a pattern with no wildcard matches one length only */
+	c0 = (signed char)*str;
+	literal = !strpbrk(str, "*?[");
+	prefilter = c0 > 0 && !strchr("*?[\\", c0);
+
+	endoff = patloc - 1;
+	resoff = expdest - (char *)stackblock();
+	cursor = startloc;
+	off = startloc;
+
+	/* an empty pattern matches nothing, unless it is anchored */
+	if (*str == '\0' && !anchored)
+		goto copyrest;
+
+	for (;;) {
+		int bestend = -1;
+		unsigned mb;
+		char *q;
+
+		str = (char *)stackblock() + strloc;
+		q = (char *)stackblock() + off;
+
+		if (subtype == VSREPLACEEND) {
+			/* the longest match that reaches the end */
+			if (pmatch(str, q))
+				bestend = endoff;
+		} else {
+			int ok = 1;
+
+			if (prefilter) {
+				const char *r = q;
+
+				mb = mbnext(r);
+				r += mb & 0xff;
+				ok = *r == c0;
+			}
+			if (ok) {
+				int eoff = off;
+
+				for (;;) {
+					char *t = (char *)stackblock() + eoff;
+					char c = *t;
+
+					*t = '\0';
+					ok = pmatch(str, (char *)stackblock() + off);
+					*t = c;
+					if (ok && (eoff > off || anchored ||
+						   endoff == startloc)) {
+						bestend = eoff;
+						if (literal)
+							break;
+					}
+					if (eoff >= endoff)
+						break;
+					mb = mbnext((char *)stackblock() + eoff);
+					eoff += (mb & 0xff) + (mb >> 8);
+					if (eoff > endoff)
+						eoff = endoff;
+				}
+			}
+		}
+
+		if (bestend >= 0) {
+			replcopy(cursor, off - cursor);
+			if (replen)
+				memtodest(repl, replen, flag);
+			cursor = bestend;
+			off = bestend;
+			if (subtype != VSREPLACEALL)
+				break;
+			if (off >= endoff)
+				break;
+			continue;
+		}
+
+		if (subtype == VSREPLACEBEG || off >= endoff)
+			break;
+		mb = mbnext((char *)stackblock() + off);
+		off += (mb & 0xff) + (mb >> 8);
+		if (off > endoff)
+			off = endoff;
+	}
+
+copyrest:
+	replcopy(cursor, endoff - cursor);
+
+	INTOFF;
+	ckfree(repl);
+	INTON;
+
+	{
+		size_t rlen = expdest - (char *)stackblock() - resoff;
+
+		loc = (char *)stackblock() + startloc;
+		memmove(loc, (char *)stackblock() + resoff, rlen);
+		loc += rlen;
+	}
+	*loc = '\0';
+	STADJUST(loc - expdest, expdest);
+
+	/* Remove any recorded regions beyond start of variable */
+	removerecordregions(startloc);
+
+	return p;
+}
